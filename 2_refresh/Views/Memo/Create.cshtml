@{
    ViewData["Title"] = "新增備忘錄";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4">➕ 新增備忘錄</h2>

            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post" action="/Memo/Create">
                        <div class="mb-3">
                            <label class="form-label text-muted">訂單標題 / 備忘錄內容</label>
                            <input type="text" class="form-control form-control-lg" name="title" placeholder="請輸入內容..." required autofocus>
                        </div>
                        
                        <div class="d-flex justify-content-end mt-4">
                            <a asp-controller="Memo" asp-action="Index" class="btn btn-outline-secondary me-2">取消返回</a>
                            <button type="submit" class="btn btn-primary">儲存並返回列表</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>