@model MyWebApp.Models.Memo

@{
    ViewData["Title"] = $"備忘錄 #{Model.Id}";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @* 訊息提示區 ... (保持原樣) *@

            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">📄 備忘錄詳細資訊</h4>
                    <div>
                        <button id="btn-edit" class="btn btn-light btn-sm fw-bold">
                            ✏️ 進入編輯
                        </button>

                        <button id="btn-cancel" class="btn btn-danger btn-sm fw-bold d-none">
                            ❌ 取消
                        </button>
                    </div>
                </div>

                <div class="card-body py-4">
                    <form asp-action="Edit" method="post" onsubmit="MemoController.allowLeave()">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <input type="hidden" id="log-start-time" name="startTime" value="" />
                        <p class="text-muted mb-1">訂單號碼：# @Model.Id</p>

                        <div id="view-mode">
                            <h3 class="fw-bold">@Model.Title</h3>
                        </div>

                        <div id="edit-mode" class="d-none">
                            <input type="text" name="title" class="form-control form-control-lg mb-3"
                                value="@Model.Title" required>
                            <button type="submit" class="btn btn-success w-100">💾 儲存變更</button>
                        </div>
                    </form>
                </div>
                @* 卡片腳部 ... (保持原樣) *@
            </div>
        </div>
    </div>
</div>

<script src="~/js/memo-details.js" asp-append-version="true"></script>

<script>
    // 2. 不要用 import，直接使用 memoController 實例
    document.addEventListener("DOMContentLoaded", function () {
        var isLockedByMe = @(ViewBag.IsLockedByMe.ToString().ToLower());

        if (typeof memoController !== 'undefined') {
            memoController.init(@Model.Id, isLockedByMe);
        }

        // ✏️ 點擊編輯：直接呼叫進入編輯模式的私有方法 (需改為公開或透過中介)
        // 為了安全與架構，建議在 MemoController 增加一個公開方法：
        document.getElementById('btn-edit').addEventListener('click', function () {
            // 我們在 JS Class 裡補一個 startEdit() 公開方法來呼叫 #enterEditMode
            memoController.startEdit();
        });

        // ❌ 點擊取消
        document.getElementById('btn-cancel').addEventListener('click', function () {
            memoController.cancelEdit(); // 呼叫公開的取消方法
        });
    });
</script>