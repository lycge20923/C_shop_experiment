@{
    ViewData["Title"] = "資料庫管理";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4">資料庫管理控制台</h1>
        <p class="text-muted">在這裡執行 SQL 資料的 CRUD 操作</p>
    </div>

    <hr />

    <div class="row justify-content-center mt-4">
        <div class="col-md-8 text-center">
            <div class="btn-group shadow-sm" role="group" aria-label="Database Actions">
                <button type="button" id="btnAdd" class="btn btn-success btn-lg">
                    <i class="bi bi-plus-circle"></i> 新增
                </button>

                <button type="button" id="btnEdit" class="btn btn-warning btn-lg">
                    <i class="bi bi-pencil-square"></i> 編輯
                </button>

                <button type="button" id="btnSave" class="btn btn-primary btn-lg">
                    <i class="bi bi-save"></i> 儲存
                </button>
            </div>
        </div>
    </div>

    <div id="dataStatus" class="mt-5 text-center text-secondary">
        <small>目前狀態：等待操作...</small>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 點擊新增
            $("#btnAdd").click(function () {
                alert("你點擊了【新增】按鈕");
            });

            // 點擊編輯
            $("#btnEdit").click(function () {
                alert("你點擊了【編輯】按鈕");
            });

            // 點擊儲存
            $("#btnSave").click(function () {
                alert("你點擊了【儲存】按鈕");
            });
        });
    </script>
}