@model testweb.Models.Order

@{
    // 判斷訂單是否已經結案（絕對無法編輯）
    bool isFinalized = Model.Status == "已送單" || Model.Status == "已完成";
}

<div class="container mt-5 pb-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
            <h4 class="mb-0"><i class="bi bi-gear-fill"></i> 訂單管理 - @Model.OrderNumber</h4>

            @if (!isFinalized)
            {
                <button type="button" id="btnEdit" class="btn btn-light fw-bold shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> 編輯訂單
                </button>
            }
        </div>

        <div class="card-body p-4 bg-white">
            @* 警語區塊：預設隱藏，進入編輯模式才顯示 *@
            <div id="editWarning"
                class="alert alert-warning d-flex align-items-center mb-4 border-0 shadow-sm py-2 d-none" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                <div>
                    <small class="d-block fw-bold">編輯模式中：</small>
                    <span class="small">系統不會自動儲存。請養成隨時點擊下方「暫存修改」的習慣。</span>
                </div>
            </div>

            <form id="orderForm">
                <input type="hidden" name="OrderNumber" value="@Model.OrderNumber" />

                @* 基礎資訊區塊 (唯讀) *@
                <div class="row g-3 mb-4 border-bottom pb-4 bg-light mx-n4 px-4 py-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">建立時間</label>
                        <div class="fs-5 fw-bold text-dark">
                            <i class="bi bi-calendar-check me-2"></i>@Model.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">目前狀態</label>
                        <div class="d-flex align-items-center h-100">
                            <span
                                class="badge @(Model.Status == "編輯中" ? "bg-warning text-dark" : "bg-success") fs-6 shadow-sm px-3">@Model.Status</span>
                        </div>
                    </div>
                </div>

                @* 收件人資訊 (預設 disabled) *@
                <div class="row g-4">
                    <div class="col-12">
                        <h5 class="text-primary border-start border-4 border-primary ps-2 mb-4">收件人資訊</h5>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">收件姓名</label>
                            <input type="text" class="form-control form-control-lg edit-field" name="CustomerName"
                                value="@Model.CustomerName" disabled>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">聯絡電話</label>
                            <input type="text" class="form-control form-control-lg edit-field" name="PhoneNumber"
                                value="@Model.PhoneNumber" disabled>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">配送地址</label>
                            <input type="text" class="form-control form-control-lg edit-field" name="ShippingAddress"
                                value="@Model.ShippingAddress" disabled>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">備註說明</label>
                            <textarea class="form-control form-control-lg edit-field" rows="3" name="Note"
                                disabled>@Model.Note</textarea>
                        </div>
                    </div>
                </div>

                @* 商品明細 (預設 disabled) *@
                <div class="mt-5">
                    <h5 class="text-primary border-start border-4 border-primary ps-2 mb-3">購買商品明細</h5>
                    <div class="accordion shadow-sm" id="productAccordion">
                        @for (int i = 0; i < Model.OrderItems.Count; i++)
                        {
                            var item = Model.OrderItems[i];
                            var collapseId = "collapse" + i;
                            <div class="accordion-item item-row">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed bg-white" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                        <div class="d-flex justify-content-between w-100 me-3 align-items-center">
                                            <span class="fw-bold text-primary"><i class="bi bi-box-seam me-2"></i>商品 @(i +
                                                                                            1)</span>
                                        <span class="text-muted small">小計: <span
                                                class="text-danger fw-bold header-subtotal">$@item.SubTotal.ToString("N0")</span></span>
                                    </div>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse"
                                data-bs-parent="#productAccordion">
                                <div class="accordion-body bg-white border-top">
                                    <input type="hidden" name="OrderItems[@i].Id" value="@item.Id" />
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-muted">商品名稱</label>
                                            <input type="text" class="form-control edit-field"
                                                name="OrderItems[@i].ProductName" value="@item.ProductName" disabled>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold small text-muted">規格/顏色</label>
                                            <input type="text" class="form-control edit-field"
                                                name="OrderItems[@i].Color" value="@item.Color" disabled>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold small text-muted">數量</label>
                                            <input type="number" class="form-control edit-field input-qty"
                                                name="OrderItems[@i].Quantity" value="@item.Quantity" min="1" disabled>
                                        </div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-muted">單價</label>
                                            <input type="number" class="form-control edit-field input-price"
                                                name="OrderItems[@i].UnitPrice" value="@item.UnitPrice" disabled>
                                        </div>
                                        <div class="col-md-6 text-end d-flex align-items-end justify-content-end">
                                            <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-remove-item d-none">移除此項</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                                                }
                    </div>
                    <button type="button" id="btnAddItem"
                        class="btn btn-link text-decoration-none fw-bold text-primary py-3 w-100 border-dashed rounded shadow-sm d-none mt-3">
                        <i class="bi bi-plus-lg me-2"></i>新增商品項目
                    </button>
                </div>

                <div class="text-end mt-4 p-4 bg-light border rounded shadow-sm">
                    <span class="fw-bold me-3 text-secondary">訂單應付總額</span>
                    <span id="totalAmountDisplay"
                        class="text-danger fw-bold fs-2">$@Model.TotalAmount.ToString("N0")</span>
                </div>
            </form>

            @* 底部動作列 *@
            <div class="fixed-bottom bg-white border-top shadow-lg p-3 d-flex justify-content-center gap-3"
                style="z-index: 1050;">
                @* 檢視模式按鈕 *@
                <div id="viewModeGroup">
                    <a href="/Home/DatabaseTest" class="btn btn-secondary px-5 fw-bold"><i
                            class="bi bi-arrow-left me-2"></i>返回列表</a>
                    <button type="button" class="btn btn-outline-primary px-5 fw-bold" onclick="window.print()"><i
                            class="bi bi-printer me-2"></i>列印</button>
                </div>
                @* 編輯模式按鈕 (預設隱藏) *@
                <div id="editModeGroup" class="d-none">
                    <button type="button" id="btnSave" class="btn btn-warning px-5 fw-bold shadow-sm"><i
                            class="bi bi-save me-2"></i>暫存修改</button>
                    <button type="button" id="btnSubmit" class="btn btn-primary px-5 fw-bold shadow-sm"><i
                            class="bi bi-send-check me-2"></i>正式送出</button>
                    <button type="button" class="btn btn-outline-secondary px-5 fw-bold"
                        onclick="location.reload()">取消變更</button>
                </div>
            </div>
            <div style="height: 100px;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        const orderId = '@Model.OrderNumber';
        const myName = "@Html.Raw(ViewBag.CurrentUser)";
        let isEditing = false;
        let isSafeExit = false;
        let initialFormData = "";
        let itemIndex = @Model.OrderItems.Count;

        $(document).ready(function () {
            if ("@ViewBag.AutoStartEdit" === "True") {
                enterEditMode();
            }

            function showOverlay(message) {
                // 移除可能已存在的 overlay
                $("#takeover-overlay").remove();

                const overlay = $(`
                        <div id="takeover-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);color:white;z-index:10000;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;">
                            <div class="spinner-border text-warning mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                            <h3 class="fw-bold">${message}</h3>
                            <p class="text-light mt-2">請勿關閉視窗，系統正在確保您的變更已安全同步...</p>
                        </div>
                    `).appendTo('body');
            }

            // --- SignalR 初始化 ---
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .withAutomaticReconnect()
                .build();

            connection.start().then(() => {
                connection.invoke("JoinOrderGroup", orderId);
                connection.invoke("RegisterUser", myName);
            });

            // 監聽：有人搶單 (被踢掉)
            connection.on("OnTakeoverRequested", function (newOwner) {
                if (newOwner === myName) return;

                isSafeExit = true; // 確保重整時不跳瀏覽器預設警告

                // 1. A 執行自動儲存 (遺言存檔)
                var formData = $("#orderForm").serialize();
                $.ajax({
                    url: '/Order/UpdateOrder',
                    type: 'POST',
                    data: formData,
                    success: function () {
                        // 2. ✨ 存檔成功後，立即正式轉移鎖定給 B
                        $.post('/Order/FinalizeTakeover', { id: orderId, newOwner: newOwner }, function () {
                            // 3. ✨ 關鍵：立即通知 B，讓他可以重整進場 (B 不用等 A 按確定)
                            connection.invoke("NotifyTakeoverComplete", orderId, newOwner);

                            // 4. ✨ 顯示一個不具「阻塞性」的視窗告知 A (例如用自定義的 HTML 或是簡單的 Confirm)
                            // 這裡我們建立一個全螢幕遮罩，中間放一個按鈕讓 A 確認
                            showTakeoverModal(newOwner);
                        });
                    }
                });
            });

            // A 被搶單時顯示的專用視窗
            function showTakeoverModal(newOwner) {
                // 移除可能存在的舊遮罩
                $("#takeover-notice").remove();

                const modalHtml = `
                <div id="takeover-notice" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:9999;display:flex;justify-content:center;align-items:center;">
                    <div class="bg-white p-5 rounded shadow-lg text-center" style="max-width:400px;">
                        <h3 class="text-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i> 編輯權接管通知</h3>
                        <p class="mb-4">專員 <strong>[${newOwner}]</strong> 已取得此訂單的編輯權。<br>您的修改已安全同步。</p>
                        <button type="button" class="btn btn-primary w-100 fw-bold" onclick="window.location.reload()">我知道了，重新整理</button>
                    </div>
                </div>
            `;
                $('body').append(modalHtml);
            }

            // 監聽：資料同步完成訊號 (當 A 存完，B 準備進場)
            connection.on("OnDataSynced", function (targetUser) {
                if (targetUser === myName) {
                    console.log("A 已完成同步，B 準備進場...");
                    // ✨ 使用 autoEdit=true 讓 B 重整後直接變彩色編輯模式
                    window.location.href = `/Order/Details?id=${orderId}&autoEdit=true`;
                }
            });

            // 監聽：重複分頁
            connection.on("OnDuplicateTabDetected", function () {
                isSafeExit = true;
                alert("⚠️ 偵測到重複分頁：您已在另一個視窗開啟此頁面。");
                window.location.href = "/Home/DatabaseTest";
            });

            // --- 編輯控制邏輯 ---

            $("#btnEdit").click(function () {
                const btn = $(this);
                // 點擊瞬間先變更狀態，避免重複點擊
                btn.prop("disabled", true).text("檢查中...");

                $.post('/Order/TryStartEdit', { id: orderId, user: myName }, function (res) {
                    if (res.success) {
                        enterEditMode();
                    } else if (res.isLocked) {
                        // 有人在改，詢問是否搶奪
                        if (confirm(`【警告】專員 [${res.lockedBy}] 正在編輯中，是否強制搶奪編輯權？`)) {
                            handleTakeoverRequest(btn); // 傳入按鈕物件以利控制
                        } else {
                            // 取消搶單，恢復按鈕
                            btn.prop("disabled", false).html('<i class="bi bi-pencil-square me-1"></i> 編輯訂單');
                        }
                    } else {
                        alert("錯誤：" + res.message);
                        btn.prop("disabled", false).html('<i class="bi bi-pencil-square me-1"></i> 編輯訂單');
                    }
                });
            });

            // 進入編輯模式的 UI 切換 (新增：按鈕變灰且改字)
            function enterEditMode() {
                isEditing = true;

                // 1. 處理右上角編輯按鈕：反灰並改字
                $("#btnEdit").prop("disabled", true)
                    .removeClass("btn-light")
                    .addClass("btn-secondary")
                    .html('<i class="bi bi-lock-fill me-1"></i> 正在編輯');
                $("#btnEdit").show(); // 確保它是顯示的但不能按

                // 2. 解除欄位禁用
                $(".edit-field").prop("disabled", false);

                // 3. 顯示功能按鈕與警語
                $(".btn-remove-item, #btnAddItem, #editWarning").removeClass("d-none");
                $("#viewModeGroup").addClass("d-none");
                $("#editModeGroup").removeClass("d-none");

                // 4. 拍下快照
                initialFormData = $("#orderForm").serialize();
            }

            function handleTakeoverRequest(editBtn) {
                editBtn.prop("disabled", true).text("等待對方同步資料...");

                $.post('/Order/RequestForceTakeover', { id: orderId, newOwner: myName }, function (res) {
                    if (!res.success) {
                        alert("搶單失敗：" + res.message);
                        location.reload();
                    }
                    // 這裡不需要寫 setTimeout，因為我們在上面監聽 OnDataSynced
                });
            }

            // --- 其他功能邏輯 (計算、新增、存檔) ---

            $(document).on("input change", ".input-qty, .input-price", function () {
                updateTotalAmount();
            });

            function updateTotalAmount() {
                let total = 0;
                $(".item-row").each(function () {
                    const qty = parseFloat($(this).find(".input-qty").val()) || 0;
                    const price = parseFloat($(this).find(".input-price").val()) || 0;
                    const subtotal = qty * price;
                    $(this).find(".header-subtotal").text("$" + subtotal.toLocaleString());
                    total += subtotal;
                });
                $("#totalAmountDisplay").text("$" + total.toLocaleString());
            }

            $("#btnSave").click(function () {
                $.post('/Order/UpdateOrder', $("#orderForm").serialize(), function (res) {
                    if (res.success) {
                        initialFormData = $("#orderForm").serialize();
                        alert("暫存成功！");
                    }
                });
            });

            $("#btnSubmit").click(function () {
                if (!confirm("確定要正式送出嗎？送出後將無法再修改。")) return;
                $.post('/Order/UpdateOrder', $("#orderForm").serialize() + "&isSubmit=true", function (res) {
                    if (res.success) {
                        isSafeExit = true;
                        alert("訂單已送出！");
                        window.location.reload();
                    }
                });
            });

            window.addEventListener('beforeunload', function (e) {
                if (!isEditing || isSafeExit) return;
                if ($("#orderForm").serialize() !== initialFormData) {
                    e.preventDefault();
                    e.returnValue = '';
                }
            });

            // 離場自動解鎖
            window.addEventListener('pagehide', function () {
                if (isEditing && !isSafeExit) {
                    navigator.sendBeacon('/Order/UnlockOrder?id=' + orderId);
                }
            });
        });
    </script>
    <style>
        #btnEdit:disabled {
            cursor: not-allowed;
            opacity: 0.8;
        }

        .border-dashed {
            border: 2px dashed #dee2e6 !important;
        }

        .border-dashed:hover {
            background-color: #f8f9fa;
            border-color: #0d6efd !important;
            color: #0d6efd !important;
        }

        .fixed-bottom {
            transition: all 0.3s ease;
        }

        .edit-field:disabled {
            background-color: #f8f9fa !important;
            color: #6c757d;
        }
    </style>
}