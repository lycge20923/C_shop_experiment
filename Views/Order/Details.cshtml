@model testweb.Models.Order

@{
    // 取得後端傳來的鎖定狀態
    bool isLockedByOthers = ViewBag.IsLockedByOthers ?? false;

    // 核心邏輯：如果是別人在改，或是訂單已完成，就設為唯讀
    bool isReadOnly = Model.Status == "已送單" || Model.Status == "已完成" || isLockedByOthers;

    // 定義 HTML 屬性字串
    string attr = isReadOnly ? "readonly" : "";
    string disabledAttr = isReadOnly ? "disabled" : "";
    string inputClass = isReadOnly ? "form-control-lg bg-light text-muted" : "form-control-lg custom-input";
}

<div class="container mt-5 pb-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
            <h4 class="mb-0"><i class="bi bi-gear-fill"></i> 訂單管理 - @Model.OrderNumber</h4>
        </div>

        <div class="card-body p-4 bg-white">


            @if (ViewBag.IsLockedByOthers == true)
            {
                <div id="lockBanner"
                    class="alert alert-warning d-flex justify-content-between align-items-center shadow-sm mb-4 border-start border-4 border-warning">
                    <div>
                        <i class="bi bi-person-fill-lock fs-4 me-2"></i>
                        <strong>這筆訂單正在被 [@Html.Raw(Model.LockedBy)] 編輯中，已鎖定</strong>
                    </div>
                    <button type="button" id="btnTakeover" class="btn btn-danger btn-sm fw-bold px-3">
                        <i class="bi bi- lightning-charge-fill me-1"></i>強制搶單
                    </button>
                </div>
            }

            <div id="editWarning" class="alert alert-warning d-flex align-items-center mb-4 border-0 shadow-sm py-2"
                role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                <div>
                    <small class="d-block fw-bold">編輯須知：</small>
                    <span class="small">系統**不會自動儲存**您的變更。若遇意外關機或連線中斷，內容將會遺失，請養成隨時點擊下方「暫存修改」的習慣。</span>
                </div>
            </div>
            <form id="orderForm">
                @* 狀態與時間區塊 *@
                <input type="hidden" name="OrderNumber" value="@Model.OrderNumber" />
                <div class="row g-3 mb-4 border-bottom pb-4 bg-light mx-n4 px-4 py-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">建立時間</label>
                        <div class="fs-5 fw-bold text-dark">
                            <i class="bi bi-calendar-check me-2"></i>@Model.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">目前狀態</label>
                        <div class="d-flex align-items-center h-100">
                            <span
                                class="badge @(Model.Status == "編輯中" ? "bg-warning text-dark" : "bg-success") fs-6 shadow-sm px-3">@Model.Status</span>
                            <span class="ms-2 text-muted small italic">@(isReadOnly ? "(唯讀模式)" : "(編輯模式)")</span>
                        </div>
                    </div>
                </div>

                @* 收件人資訊 *@
                <div class="row g-4">
                    <div class="col-12">
                        <h5 class="text-primary border-start border-4 border-primary ps-2 mb-4">收件人資訊編輯</h5>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">收件姓名</label>
                            <input type="text" class="form-control @inputClass" name="CustomerName"
                                value="@Model.CustomerName" @attr>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">聯絡電話</label>
                            <input type="text" class="form-control @inputClass" name="PhoneNumber"
                                value="@Model.PhoneNumber" @attr>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">配送地址</label>
                            <input type="text" class="form-control @inputClass" name="ShippingAddress"
                                value="@Model.ShippingAddress" @attr>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">備註說明</label>
                            <textarea class="form-control @inputClass" rows="3" name="Note" @attr>@Model.Note</textarea>
                        </div>
                    </div>
                </div>

                @* 商品明細 *@
                <div class="mt-5">
                    <h5 class="text-primary border-start border-4 border-primary ps-2 mb-3">購買商品明細 (可編輯項目)</h5>
                    <div class="accordion shadow-sm" id="productAccordion">
                        @for (int i = 0; i < Model.OrderItems.Count; i++)
                        {
                            var item = Model.OrderItems[i];
                            var collapseId = "collapse" + i;
                            var headingId = "heading" + i;

                            <div class="accordion-item item-row">
                                <h2 class="accordion-header" id="@headingId">
                                    <button class="accordion-button collapsed bg-white" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                        <div class="d-flex justify-content-between w-100 me-3 align-items-center">
                                            <span class="fw-bold text-primary"><i class="bi bi-box-seam me-2"></i>商品 @(i +
                                                                                            1)</span>
                                        <span class="text-muted small">小計: <span
                                                class="text-danger fw-bold header-subtotal">$@item.SubTotal.ToString("N0")</span></span>
                                    </div>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse"
                                data-bs-parent="#productAccordion">
                                <div class="accordion-body bg-white border-top">
                                    <input type="hidden" name="OrderItems[@i].Id" value="@item.Id" />
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-muted">商品名稱</label>
                                            <input type="text" class="form-control @inputClass"
                                                name="OrderItems[@i].ProductName" value="@item.ProductName" @attr>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold small text-muted">規格/顏色</label>
                                            <input type="text" class="form-control @inputClass"
                                                name="OrderItems[@i].Color" value="@item.Color" @attr>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold small text-muted">年代/品項</label>
                                            <input type="text" class="form-control @inputClass"
                                                name="OrderItems[@i].Year" value="@item.Year" @attr>
                                        </div>
                                    </div>
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-3">
                                            <label class="form-label fw-bold small text-muted">數量</label>
                                            <input type="number" class="form-control @inputClass input-qty"
                                                name="OrderItems[@i].Quantity" value="@item.Quantity" min="1" @attr>
                                        </div>
                                        <div class="col-md-9">
                                            <label class="form-label fw-bold small text-muted">商品備註說明</label>
                                            <input type="text" class="form-control @inputClass"
                                                name="OrderItems[@i].ItemNote" value="@item.ItemNote" @attr>
                                        </div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-muted">單價 (系統預設)</label>
                                            <div class="input-group">
                                                <span class="input-group-text border-0 bg-light fw-bold">$</span>
                                                <input type="text" readonly
                                                    class="form-control form-control-lg bg-light fw-bold input-price"
                                                    value="@item.UnitPrice.ToString("N0")">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold small text-muted">該項小計 (唯讀)</label>
                                            <div class="input-group">
                                                <span
                                                    class="input-group-text border-0 bg-light fw-bold text-danger">$</span>
                                                <input type="text" readonly
                                                    class="form-control form-control-lg bg-light fw-bold text-danger input-subtotal"
                                                    value="@item.SubTotal.ToString("N0")">
                                            </div>
                                        </div>
                                    </div>
                                    @if (!isReadOnly)
                                    {
                                        <div class="text-end mt-3">
                                            <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-remove-item">移除此項</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                                                }
                    </div>
                </div>

                @if (!isReadOnly)
                {
                    <div class="mt-3">
                        <button type="button" id="btnAddItem"
                            class="btn btn-link text-decoration-none fw-bold text-primary py-3 w-100 border-dashed rounded shadow-sm">
                            <i class="bi bi-plus-lg me-2"></i>新增商品項目
                        </button>
                    </div>
                }

                <div class="text-end mt-4 p-4 bg-light border rounded shadow-sm">
                    <span class="fw-bold me-3 text-secondary">訂單應付總額</span>
                    <span class="text-danger fw-bold fs-2">$@Model.TotalAmount.ToString("N0")</span>
                </div>
            </form>

            @* 底部固定列：合併後的邏輯 *@
            <div class="fixed-bottom bg-white border-top shadow-lg p-3 d-flex justify-content-center gap-3"
                style="z-index: 1050;">
                @if (!isReadOnly)
                {
                    <button type="button" id="btnSave" class="btn btn-warning px-5 fw-bold shadow-sm"><i
                            class="bi bi-save me-2"></i>暫存修改</button>
                    <button type="button" id="btnCancel" class="btn btn-outline-secondary px-5 fw-bold"
                        onclick="location.reload()"><i class="bi bi-x-circle me-2"></i>取消變更</button>
                    <button type="button" id="btnSubmit" class="btn btn-primary px-5 fw-bold shadow-sm"><i
                            class="bi bi-send-check me-2"></i>正式送出訂單</button>
                }
                else
                {
                    <a href="/Home/DatabaseTest" class="btn btn-secondary px-5 fw-bold"><i
                            class="bi bi-arrow-left me-2"></i>返回搜尋列表</a>
                    <button type="button" class="btn btn-outline-primary px-5 fw-bold" onclick="window.print()"><i
                            class="bi bi-printer me-2"></i>列印訂單</button>
                }
            </div>
            <div style="height: 100px;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        // 定義一個變數來紀錄是否有變更
        let initialFormData = "";
        let isSafeExit = false;
        const orderId = '@Model.OrderNumber';
        const isReadOnly = @(ViewBag.IsLockedByOthers == true ? "true" : "false");
        const myName = "@Html.Raw(ViewBag.CurrentUser)";

        $(document).ready(function () {

            // --- SignalR 即時接手邏輯開始 ---

            // 1. 建立 SignalR 連線
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .withAutomaticReconnect() // 斷線自動重連
                .build();

            // 1. 監聽重複分頁訊號
            connection.on("OnDuplicateTabDetected", function () {
                isSafeExit = true; // ✨ 這是你之前設定的旗標，避免跳出「確定要離開嗎」

                // 跳出警告
                alert("⚠️ 偵測到重複分頁：您已在另一個視窗開啟此頁面。\n為確保資料正確性，本分頁將跳回首頁。");

                // 按下確定後跳轉
                window.location.href = "/Home/DatabaseTest";
            });

            // 2. 啟動連線並加入群組
            connection.start().then(function () {
                console.log("SignalR 已連線！");
                // 通知伺服器：我要聽這張訂單 (orderId) 的消息
                connection.invoke("JoinOrderGroup", orderId);
                connection.invoke("RegisterUser", myName);

            }).catch(err => console.error("SignalR 連線失敗: ", err));

            // 3. 【核心監聽】當伺服器說「有人要搶單」時 (OnTakeoverRequested)
            connection.on("OnTakeoverRequested", function (newOwner) {
                const myName = "@ViewBag.CurrentUser"; // 取得當前瀏覽器的使用者名稱
                // ✨ 關鍵判斷：如果發起搶單的人就是我，我不需要「被踢掉」
                if (newOwner === myName) {
                    console.log("我是搶單發起者，等待對方存檔中...");
                    return;
                }

                if (isReadOnly) return;
                isSafeExit = true; // 避免 beforeunload 彈窗

                // 這裡建議加一個小 Loading 畫面，避免 A 繼續亂點
                alert("⚠️ 偵測到搶單：正在為您自動儲存並轉為唯讀模式...");

                // ✨ 確保抓取最新資料
                var formData = $("#orderForm").serialize();

                $.ajax({
                    url: '/Order/UpdateOrder',
                    type: 'POST',
                    data: formData,
                    // ✨ 加上 async: false (雖然不推薦但這裡很有效) 或確保順序
                    success: function (res) {
                        console.log("被搶單前自動存檔成功");
                        // 存檔成功才執行交接
                        $.post('/Order/FinalizeTakeover', { id: orderId, newOwner: newOwner }, function () {
                            window.location.reload();
                        });
                    },
                    error: function () {
                        // 萬一存檔失敗，還是要交接，不然會死鎖
                        $.post('/Order/FinalizeTakeover', { id: orderId, newOwner: newOwner }, function () {
                            window.location.reload();
                        });
                    }
                });
            });

            // (選配) 當交接完成，通知搶單者 (B) 重新整理
            connection.on("OnTakeoverCompleted", function () {
                // 如果我是 B，我就會收到這個，然後自動 reload
                if (isReadOnly) {
                    window.location.reload();
                }
            });

            // --- SignalR 即時接手邏輯結束 ---

            // 頁面載入完成後，立刻幫表單「拍照」
            initialFormData = $("#orderForm").serialize();
            let itemIndex = @Model.OrderItems.Count;

            // 監聽所有變動
            $(document).on("change input", "#orderForm input, #orderForm textarea, #orderForm select", function () {
                if (!isReadOnly) {
                    $("#editWarning").addClass("text-danger fw-bold");
                }
            });

            // 攔截瀏覽器關閉/重新整理
            window.addEventListener('beforeunload', function (e) {
                // 如果是唯讀模式，直接放行
                if (isReadOnly) return;

                // ✨ 如果標記為「安全離開」，就直接放行，不跳警告
                if (isSafeExit) return;

                // 即時抓取目前的表單狀態
                let currentFormData = $("#orderForm").serialize();

                // ✨ 關鍵比對：只有「現在」不等於「當初」，才跳出警告
                if (currentFormData !== initialFormData) {
                    e.preventDefault();
                    e.returnValue = ''; // 跳出瀏覽器預設的「確定要離開嗎？
                    // 這裡可以順便更新警語樣式
                    $("#editWarning").addClass("text-danger fw-bold");
                }
            });

            // 1. 金額計算 (保持不變...)
            $(document).on("input change", ".input-qty, .input-price", function () {
                var $row = $(this).closest(".accordion-body");
                var $itemRow = $(this).closest(".item-row");
                var qty = parseInt($row.find(".input-qty").val()) || 0;
                var priceText = $row.find(".input-price").val() || "0";
                var price = parseFloat(priceText.toString().replace(/,/g, '')) || 0;
                var subtotal = qty * price;
                var formattedSubtotal = subtotal.toLocaleString('zh-TW');
                $row.find(".input-subtotal").val(formattedSubtotal);
                $itemRow.find(".header-subtotal").text("$" + formattedSubtotal);
                updateTotalAmount();
            });

            // 2. 新增商品 (保持不變...)
            // 2. 【新增商品項目】按鈕邏輯
            $("#btnAddItem").click(function () {
                const newId = `collapseNew${itemIndex}`;
                const headingId = `headingNew${itemIndex}`;

                // 完整的 HTML 樣板，確保屬性與後端 Model 對齊
                const newItemHtml = `
                                                <div class="accordion-item item-row border-success-subtle shadow-sm mb-2">
                                                    <h2 class="accordion-header" id="${headingId}">
                                                        <button class="accordion-button bg-white text-success fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#${newId}">
                                                            <div class="d-flex justify-content-between w-100 me-3 align-items-center">
                                                                <span><i class="bi bi-plus-circle me-2"></i>新商品 (請輸入內容)</span>
                                                                <span class="text-muted small">小計: <span class="text-danger fw-bold header-subtotal">$0</span></span>
                                                            </div>
                                                        </button>
                                                    </h2>
                                                    <div id="${newId}" class="accordion-collapse collapse show" data-bs-parent="#productAccordion">
                                                        <div class="accordion-body bg-white border-top">
                                                            <input type="hidden" name="OrderItems[${itemIndex}].Id" value="0" />
                                                            <div class="row g-3 mb-3">
                                                                <div class="col-md-6">
                                                                    <label class="form-label fw-bold small text-muted">商品名稱</label>
                                                                    <input type="text" class="form-control form-control-lg custom-input" name="OrderItems[${itemIndex}].ProductName" placeholder="新商品名稱">
                                                                </div>
                                                                <div class="col-md-3">
                                                                    <label class="form-label fw-bold small text-muted">規格/顏色</label>
                                                                    <input type="text" class="form-control form-control-lg custom-input" name="OrderItems[${itemIndex}].Color">
                                                                </div>
                                                                <div class="col-md-3">
                                                                    <label class="form-label fw-bold small text-muted">年代/品項</label>
                                                                    <input type="text" class="form-control form-control-lg custom-input" name="OrderItems[${itemIndex}].Year">
                                                                </div>
                                                            </div>
                                                            <div class="row g-3 mb-3">
                                                                <div class="col-md-3">
                                                                    <label class="form-label fw-bold small text-muted">數量</label>
                                                                    <input type="number" class="form-control form-control-lg custom-input input-qty" name="OrderItems[${itemIndex}].Quantity" value="1" min="1">
                                                                </div>
                                                                <div class="col-md-9">
                                                                    <label class="form-label fw-bold small text-muted">商品備註說明</label>
                                                                    <input type="text" class="form-control form-control-lg custom-input" name="OrderItems[${itemIndex}].ItemNote">
                                                                </div>
                                                            </div>
                                                            <div class="row g-3">
                                                                <div class="col-md-6">
                                                                    <label class="form-label fw-bold small text-muted">單價</label>
                                                                    <div class="input-group">
                                                                        <span class="input-group-text border-0 bg-light fw-bold">$</span>
                                                                        <input type="number" class="form-control form-control-lg custom-input input-price" name="OrderItems[${itemIndex}].UnitPrice" value="0">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <label class="form-label fw-bold small text-muted">該項小計</label>
                                                                    <div class="input-group">
                                                                        <span class="input-group-text border-0 bg-light fw-bold text-danger">$</span>
                                                                        <input type="text" readonly class="form-control form-control-lg bg-light fw-bold text-danger input-subtotal" value="0">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="text-end mt-3">
                                                                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-item">移除此項</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>`;

                $("#productAccordion").append(newItemHtml);
                itemIndex++; // 索引累加
                updateTotalAmount(); // 重新計算總額

                // 觸發提醒文字變紅
                $("#editWarning").addClass("text-danger fw-bold");
            });

            // 3. 移除項目
            $(document).on("click", ".btn-remove-item", function () {
                $(this).closest(".accordion-item").remove();
                updateTotalAmount();
            });

            // 4. 更新總額 (保持不變...)
            function updateTotalAmount() {
                var total = 0;
                $(".input-subtotal").each(function () {
                    var val = $(this).val() || "0";
                    total += parseFloat(val.toString().replace(/,/g, '')) || 0;
                });
                $(".fs-2.text-danger").text("$" + total.toLocaleString('zh-TW'));
            }

            // 5. 【儲存修改】
            $("#btnSave").click(function () {
                // ... 前面的驗證邏輯 ...
                var formData = $("#orderForm").serialize();

                $.ajax({
                    url: '/Order/UpdateOrder',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.success) {
                            // ✨ 重要：儲存成功後，將「現在的樣子」設為新的「初始狀態」
                            initialFormData = formData;
                            $("#editWarning").removeClass("text-danger fw-bold");
                            alert("儲存成功！");
                            // 如果你有 reload，頁面重啟後自然會重新拍照
                            window.location.reload();
                        }
                    }
                });
            });

            // 6. 【正式送出訂單】
            $("#btnSubmit").click(function () {
                if (!confirm("確定要正式送出訂單嗎？送出後將無法再修改內容。")) return;
                if (!$("input[name='CustomerName']").val()) {
                    alert("請輸入收件人姓名");
                    return;
                }
                var formData = $("#orderForm").serialize() + "&isSubmit=true";
                $(this).prop("disabled", true).text("送出中...");

                $.ajax({
                    url: '/Order/UpdateOrder',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res.success) {
                            isDirty = false; // ✨ 送出成功，清除髒標記
                            alert("訂單已正式送出！");
                            window.location.reload();
                        } else {
                            alert("錯誤：" + res.message);
                            $("#btnSubmit").prop("disabled", false).text("正式送出訂單");
                        }
                    }
                });
            });

            $("#btnTakeover").click(function () {
                const requester = "@ViewBag.CurrentUser";
                const btn = $(this);

                if (confirm("【警告】強制搶單將會中斷目前編輯者的作業。系統會嘗試自動幫對方存檔，確定要接手嗎？")) {

                    btn.prop("disabled", true).text("請求接管中...");

                    $.post('/Order/RequestForceTakeover', { id: orderId, newOwner: requester }, function (res) {
                        if (res.success) {
                            // 1. 設定一個變數來紀錄是否已經重整過，避免重複觸發
                            let hasReloaded = false;

                            // 2. 定義重整函式
                            const doReload = () => {
                                if (!hasReloaded) {
                                    hasReloaded = true;
                                    window.location.reload();
                                }
                            };

                            // 3. ✨ 設定 3 秒自動重整 (保險機制)
                            const autoTimer = setTimeout(doReload, 3000);

                            // 4. ✨ 顯示提示視窗 (阻斷機制)
                            // 當使用者按下「確定」的那一刻，立刻執行重整
                            alert("已送出請求，請稍候 1-3 秒待系統完成交接...");

                            // 使用者按完確定後，清除計時器並立刻重整
                            clearTimeout(autoTimer);
                            doReload();

                        } else {
                            alert("請求失敗：" + res.message);
                            btn.prop("disabled", false).text("強制搶單");
                        }
                    });
                }
            });

            // 當按下「取消變更」按鈕時，主動呼叫解鎖 API
            $("#btnCancel, .btn-back").click(function (e) {
                e.preventDefault();
                $.post('/Order/UnlockOrder', { id: orderId }, function () {
                    window.location.href = '/Order/Index'; // 或你指定的路徑
                });
            });

            // 途徑 C：【核心】直接關閉分頁、關閉瀏覽器、或跳轉到其他網站
            // 使用 sendBeacon 是目前網頁開發中「最可靠」的離場通知方式
            window.addEventListener('pagehide', function () {
                if (!isReadOnly && !isSafeExit) {
                    // 使用 QueryString 方式確保後端一定收得到 id
                    navigator.sendBeacon('/Order/UnlockOrder?id=' + orderId);
                }
            });

            // 7. ✨【自動暫存邏輯】 (每 120 秒執行一次)
            setInterval(function () {
                if (isReadOnly) return;

                let currentFormData = $("#orderForm").serialize();

                // 只有真的有差才存
                if (currentFormData !== initialFormData) {
                    console.log("偵測到實質內容變更，執行自動暫存...");
                    $.ajax({
                        url: '/Order/UpdateOrder',
                        type: 'POST',
                        data: currentFormData,
                        success: function (res) {
                            if (res.success) {
                                // ✨ 自動存完後，更新快照，這樣關閉就不會跳警告
                                initialFormData = currentFormData;
                                $("#editWarning").removeClass("text-danger fw-bold");
                            }
                        }
                    });
                }
            }, 120000);
        }); 
    </script>
